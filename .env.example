# ==========================
# FastFile 配置示例
# ==========================
# 使用方式：
# 1) 复制本文件为 fastfile.env
# 2) 按需修改变量
# 3) 服务运行中每 3 秒自动热加载（密码/会话时长）

# 访问密码。
# - 线上部署请改为你自己的强密码。
# - 你当前要求的服务器密码是 REDACTED_PASSWORD。
FASTFILE_PASSWORD=REDACTED_PASSWORD

# 服务端存储目录。
# - 存放 SQLite 数据库和上传文件。
# - 建议使用绝对路径，避免工作目录变化导致路径漂移。
# - 该项属于启动期配置，修改后建议重启服务生效。
FASTFILE_STORAGE=./storage

# 服务监听端口（不可热加载）。
# - 该项属于启动期配置，修改后需要重启服务。
# - 默认 21443。
FASTFILE_PORT=21443

# 是否允许网页按钮触发服务重启（不可热加载）。
# - 1 / true: 允许
# - 0 / false: 禁用
# - 即使开启，后端仍要求当前进程在 systemd 托管环境中运行。
FASTFILE_ALLOW_WEB_RESTART=1

# 登录会话有效期（秒）。
# - 例如 86400 = 24 小时。
# - 热加载生效：修改后约 3 秒内新请求按新值续期。
FASTFILE_SESSION_TTL_SECONDS=86400

# 配置文件路径。
# - 默认读取 ./fastfile.env。
# - 一般无需设置，除非你要把配置放到其他目录。
# FASTFILE_CONFIG_FILE=./fastfile.env
