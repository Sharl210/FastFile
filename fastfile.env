# ==========================
# FastFile 运行配置（默认加载）
# ==========================
# 说明：
# - 本文件默认路径为 ./fastfile.env
# - 服务会每 3 秒自动重新读取本文件
# - 热加载项：FASTFILE_PASSWORD、FASTFILE_SESSION_TTL_SECONDS

# 访问密码。支持多个密码用英文逗号分隔，每个密码都会映射成独立用户
# 例如：FASTFILE_PASSWORD=REDACTED_PASSWORD,050211,050212
FASTFILE_PASSWORD=REDACTED_PASSWORD

# 服务端存储目录（数据库 + 上传文件）
# 建议改为你的持久化目录，例如 /data/fastfile
FASTFILE_STORAGE=./storage

# 服务监听端口（不可热加载）
# 修改后需要重启服务生效
# 默认建议使用 21443
FASTFILE_PORT=21443

# 是否允许网页按钮触发服务重启（不可热加载）
# - 1 / true: 允许
# - 0 / false: 禁用
# - 为了安全，后端还会检查是否为 systemd 托管环境；非 systemd 会直接拒绝重启
FASTFILE_ALLOW_WEB_RESTART=1

# 会话有效期（秒）
# 86400 秒 = 24 小时
FASTFILE_SESSION_TTL_SECONDS=86400

# 可选：指定配置文件路径（通常不需要）
# FASTFILE_CONFIG_FILE=./fastfile.env
